generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Who can do what. Reporting officers work at a bank or financial institution;
/// analysts, supervisors and admins work at the financial intelligence unit.
enum Role {
  REPORTING_OFFICER
  ANALYST
  SUPERVISOR
  ADMIN
}

/// Institutions that must report under Nepal's anti-money-laundering law.
enum EntityType {
  COMMERCIAL_BANK
  DEVELOPMENT_BANK
  FINANCE_COMPANY
  MICROFINANCE
  COOPERATIVE
  INSURANCE
  REMITTANCE
  CAPITAL_MARKET
}

enum SubjectKind {
  INDIVIDUAL
  ORGANIZATION
}

enum Direction {
  CREDIT
  DEBIT
}

enum Channel {
  CASH
  TRANSFER
  CONNECT_IPS
  WALLET
  REMITTANCE
  CHEQUE
}

/// STR: suspicious transaction report filed by an institution.
/// TTR: threshold transaction report (cash of Rs 10 lakh or more).
/// RULE: raised by the detection rules.
enum AlertType {
  STR
  TTR
  RULE
}

enum AlertStatus {
  NEW
  FALSE_POSITIVE
  ESCALATED
}

enum CaseStatus {
  OPEN
  UNDER_INVESTIGATION
  PENDING_APPROVAL
  DISSEMINATED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Typology {
  STRUCTURING
  HUNDI
  TRADE_BASED
  FRAUD
  TAX_EVASION
  CORRUPTION
  TERRORISM_FINANCING
  OTHER
}

/// Agencies a finished case can be sent to.
enum Agency {
  DMLI
  NEPAL_POLICE
  DRI
  IRD
  CIAA
  NRB
}

enum Recommendation {
  DISSEMINATE
  CLOSE
}

enum SubjectRole {
  SUSPECT
  ASSOCIATE
  VICTIM
}

model ReportingEntity {
  id        String     @id @default(uuid())
  code      String     @unique
  name      String
  nameNe    String
  type      EntityType
  createdAt DateTime   @default(now())
  users     User[]
  accounts  Account[]
  alerts    Alert[]
}

model User {
  id           String           @id @default(uuid())
  email        String           @unique
  name         String
  designation  String?
  passwordHash String
  role         Role
  active       Boolean          @default(true)
  entityId     String?
  entity       ReportingEntity? @relation(fields: [entityId], references: [id])
  createdAt    DateTime         @default(now())
  assignedCases Case[]          @relation("assignee")
  notes        CaseNote[]
  tasks        CaseTask[]
  events       AuditEvent[]
}

model Subject {
  id            String        @id @default(uuid())
  kind          SubjectKind
  name          String
  nameNe        String?
  citizenshipNo String?
  panNo         String?
  dateOfBirth   DateTime?
  district      String?
  occupation    String?
  isPep         Boolean       @default(false)
  createdAt     DateTime      @default(now())
  accounts      Account[]
  alerts        Alert[]
  cases         CaseSubject[]

  @@index([citizenshipNo])
  @@index([panNo])
}

model Account {
  id           String          @id @default(uuid())
  accountNo    String
  entityId     String
  entity       ReportingEntity @relation(fields: [entityId], references: [id])
  subjectId    String
  subject      Subject         @relation(fields: [subjectId], references: [id])
  openedAt     DateTime?
  lastActiveAt DateTime?
  transactions Transaction[]

  @@unique([entityId, accountNo])
}

model Transaction {
  id                  String             @id @default(uuid())
  reference           String
  accountId           String
  account             Account            @relation(fields: [accountId], references: [id])
  direction           Direction
  channel             Channel
  amount              Decimal            @db.Decimal(16, 2)
  counterpartyName    String?
  counterpartyAccount String?
  narration           String?
  district            String?
  occurredAt          DateTime
  alerts              AlertTransaction[]

  @@unique([accountId, reference])
  @@index([occurredAt])
}

model Alert {
  id          String             @id @default(uuid())
  reference   String             @unique
  type        AlertType
  status      AlertStatus        @default(NEW)
  ruleCode    String?
  score       Int
  summary     String
  narrative   String?
  entityId    String
  entity      ReportingEntity    @relation(fields: [entityId], references: [id])
  subjectId   String
  subject     Subject            @relation(fields: [subjectId], references: [id])
  caseId      String?
  case        Case?              @relation(fields: [caseId], references: [id])
  triagedById String?
  triagedAt   DateTime?
  triageNote  String?
  createdAt   DateTime           @default(now())
  transactions AlertTransaction[]

  @@index([status, createdAt])
}

model AlertTransaction {
  alertId       String
  alert         Alert       @relation(fields: [alertId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])

  @@id([alertId, transactionId])
}

model Case {
  id             String          @id @default(uuid())
  reference      String          @unique
  title          String
  summary        String?
  status         CaseStatus      @default(OPEN)
  priority       Priority        @default(MEDIUM)
  typology       Typology        @default(OTHER)
  assigneeId     String?
  assignee       User?           @relation("assignee", fields: [assigneeId], references: [id])
  createdById    String
  dueAt          DateTime
  recommendation Recommendation?
  submittedById  String?
  agency         Agency?
  disseminatedAt DateTime?
  closedAt       DateTime?
  closureReason  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  alerts         Alert[]
  subjects       CaseSubject[]
  notes          CaseNote[]
  tasks          CaseTask[]
  events         AuditEvent[]

  @@index([status, dueAt])
}

model CaseSubject {
  caseId    String
  case      Case        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id])
  role      SubjectRole @default(SUSPECT)

  @@id([caseId, subjectId])
}

model CaseNote {
  id        String   @id @default(uuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model CaseTask {
  id         String    @id @default(uuid())
  caseId     String
  case       Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  title      String
  assigneeId String?
  assignee   User?     @relation(fields: [assigneeId], references: [id])
  dueAt      DateTime?
  doneAt     DateTime?
  createdAt  DateTime  @default(now())
}

/// Append-only log of everything that happens to alerts and cases.
model AuditEvent {
  id        String   @id @default(uuid())
  caseId    String?
  case      Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  alertId   String?
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

/// Running numbers for reference codes, one row per prefix and fiscal year.
model Counter {
  key   String @id
  value Int    @default(0)
}
